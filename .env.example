# Server Configuration
PORT=3000
NODE_ENV=development

# Security JWT Secret (change this in production)
JWT_SECRET=smart_todo_super_secret_key_12345!

# CORS (Allowed origins, separated by comma)
CORS_ORIGIN=http://localhost:3000

# MySQL Database Configuration
# Leave DB_HOST, DB_USER, and DB_NAME blank to automatically 
# activate the SQLite local file database fallback (todo.db).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_todo_db
